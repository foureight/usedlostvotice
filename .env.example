NEXT_PUBLIC_SITE_URL=https://usedlostvodice.cz
NEXT_PUBLIC_OWNER_EMAIL=michal@tribo.cz
NEXT_PUBLIC_OWNER_PHONE=+420 736 483 646
NEXT_PUBLIC_AGENT_EMAIL=loskot@bioreality.cz
NEXT_PUBLIC_AGENT_PHONE=+420 774 235 689

# Heslo k administraci /admin (fallback, když není GitHub mode)
ADMIN_USER=michal@tribo.cz
ADMIN_PASSWORD=zmen-me

# Keystatic GitHub mode (varianta 1)
# Vzniknou po „Create GitHub App“ na /keystatic — zkopíruj i na Zerops.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# SMTP — preferujte vyplnění v administraci /keystatic → E-mail / SMTP.
# Env hodnoty mají přednost (vhodné pro tajné heslo na Zerops).
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@usedlost-vodice.cz
SMTP_FROM_NAME=Usedlost Vodice
SMTP_TO_EMAIL=michal@tribo.cz
SMTP_CC_EMAIL=loskot@bioreality.cz
SMTP_SUBJECT_PREFIX=[Usedlost Vodice]
